# ローカル開発用。AWS本番環境ではIAMロールを使用してください。
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=tocoro-cleaning-report-881224647732-ap-northeast-1-an

# 共有ログイン（AUTH_SECRETは32文字以上のランダム文字列）
APP_PASSWORD=
AUTH_SECRET=

# Lambdaではデプロイスクリプトが以下を自動設定します
# APP_PASSWORD_SECRET_ID=
# AUTH_SECRET_ID=
# LOGIN_ATTEMPTS_PREFIX=_system/login-attempts

# 希望シフト用。GASの /exec URL と、GAS Script Properties に設定した専用署名鍵。
# SHIFT_GAS_URL=
# SHIFT_GAS_SECRET=
# 旧版のGASで年月一覧が利用できない場合だけ表示する確認済みの年月（カンマ区切り）。
# SHIFT_GAS_LEGACY_MONTHS=
