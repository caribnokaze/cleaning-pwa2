{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageTocoroLambdaFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:CreateFunctionUrlConfig",
        "lambda:GetFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig",
        "lambda:AddPermission"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-1:881224647732:function:tocoro-cleaning-report"
    },
    {
      "Sid": "ManageTocoroLambdaRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::881224647732:role/TocoroCleaningLambdaRole"
    },
    {
      "Sid": "AttachLambdaLoggingPolicy",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::881224647732:role/TocoroCleaningLambdaRole",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "PassTocoroRoleOnlyToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::881224647732:role/TocoroCleaningLambdaRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ConfigurePhotoBucketCors",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketCORS",
        "s3:PutBucketCORS"
      ],
      "Resource": "arn:aws:s3:::tocoro-cleaning-report-881224647732-ap-northeast-1-an"
    },
    {
      "Sid": "ConfigureLambdaImageRepository",
      "Effect": "Allow",
      "Action": "ecr:SetRepositoryPolicy",
      "Resource": "arn:aws:ecr:ap-northeast-1:881224647732:repository/tocoro-cleaning-report-lambda"
    }
  ]
}
